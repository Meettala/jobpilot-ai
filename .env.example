# Optional provider mode is disabled by default. API keys are ignored unless
# ENABLE_PROVIDER_MODE is explicitly set to true.
ENABLE_PROVIDER_MODE=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Needed once the app is wired to persist jobs/evidence to Supabase
# (not required for the current in-memory demo mode).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

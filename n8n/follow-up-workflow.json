{
  "name": "JobPilot AI - Daily Follow-up Check",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "days", "daysInterval": 1 }] }
      },
      "name": "Daily Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{$env.JOBPILOT_APP_URL}}/api/jobs/needs-follow-up",
        "method": "GET",
        "options": {}
      },
      "name": "Get Jobs Needing Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [420, 300],
      "notes": "Read-only call. This node has no ability to send anything - it only retrieves suggestions computed by the same logic the in-app tracker uses (src/lib/tracker/suggestions.ts)."
    },
    {
      "parameters": {
        "fieldToSplitOut": "suggestions",
        "options": {}
      },
      "name": "Split Suggestions",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "url": "={{$env.JOBPILOT_APP_URL}}/api/approval-queue",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "jobId", "value": "={{$json.jobId}}" },
            { "name": "actionType", "value": "={{$json.actionType}}" },
            { "name": "proposedContent", "value": "={{$json.proposedContent}}" }
          ]
        }
      },
      "name": "Write to Approval Queue (pending only)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [860, 300],
      "notes": "This ONLY creates a 'pending' item - see /api/approval-queue POST handler. No email, message, or LinkedIn node exists anywhere in this workflow. A human must open the app's /jobs page and click Approve before anything happens."
    }
  ],
  "connections": {
    "Daily Trigger": { "main": [[{ "node": "Get Jobs Needing Follow-up", "type": "main", "index": 0 }]] },
    "Get Jobs Needing Follow-up": { "main": [[{ "node": "Split Suggestions", "type": "main", "index": 0 }]] },
    "Split Suggestions": { "main": [[{ "node": "Write to Approval Queue (pending only)", "type": "main", "index": 0 }]] }
  }
}
